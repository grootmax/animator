{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@animator/core": ["./packages/core/src/index.ts"],
      "@animator/render": ["./packages/render/src/index.ts"],
      "@animator/gen": ["./packages/gen/src/index.ts"]
    }
  }
}
