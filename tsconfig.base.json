{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@monorepo/core": ["./packages/core/src/index.ts"],
      "@monorepo/core/*": ["./packages/core/src/*"],
      "@animator/core": ["./packages/core/src/index.ts"],
      "@animator/core/*": ["./packages/core/src/*"]
    }
  }
}
