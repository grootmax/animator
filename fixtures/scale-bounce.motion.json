{
  "version": 1,
  "name": "scale-bounce",
  "canvas": {
    "width": 100,
    "height": 100,
    "fps": 30,
    "duration": 1,
    "background": "#0B1020"
  },
  "layers": [
    {
      "id": "ball",
      "type": "shape",
      "position": [50, 50],
      "scale": [100, 100],
      "shape": {
        "kind": "ellipse",
        "size": [30, 30]
      },
      "fill": "#B07AA1",
      "keyframes": {
        "scale": [
          {
            "t": 0,
            "v": [20, 20],
            "ease": "easeOutBack"
          },
          {
            "t": 1,
            "v": [100, 100]
          }
        ]
      }
    }
  ]
}
