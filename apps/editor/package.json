{
  "name": "@monorepo/editor",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "tsc -b && vite build && npm run build:electron && npm run build:preload",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --outdir=dist-electron --external:electron",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --outdir=dist-electron --external:electron",
    "package": "electron-builder build --mac --linux"
  },
  "build": {
    "appId": "com.monorepo.editor",
    "productName": "MonorepoEditor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": "zip"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@monorepo/runtime-player": "*",
    "@monorepo/animation-engine": "*",
    "@monorepo/renderer": "*",
    "@monorepo/scene-graph": "*",
    "@monorepo/serialization": "*",
    "lucide-react": "^0.279.0",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "zod": "^4.4.3",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.15",
    "electron": "^25.3.0",
    "electron-builder": "^24.6.4",
    "esbuild": "^0.18.20",
    "postcss": "^8.4.29",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5"
  }
}
