{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@monorepo/math": ["../../packages/math/src"],
      "@monorepo/scene-graph": ["../../packages/scene-graph/src"],
      "@monorepo/animation-engine": ["../../packages/animation-engine/src"],
      "@monorepo/renderer": ["../../packages/renderer/src"],
      "@monorepo/runtime-player": ["../runtime-player/src"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../packages/math" },
    { "path": "../../packages/scene-graph" },
    { "path": "../../packages/animation-engine" },
    { "path": "../../packages/renderer" },
    { "path": "../runtime-player" }
  ]
}
